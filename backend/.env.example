# Answer generation — pick a provider (both free-tier):
#   groq   -> free key at https://console.groq.com  (works instantly)
#   gemini -> free key at https://aistudio.google.com/apikey
LLM_PROVIDER=groq

GROQ_API_KEY=
GOOGLE_API_KEY=

# Vector store: "local" (numpy, zero setup) or "pgvector"
VECTOR_STORE=local

# Accounts: "local" (JSON file) or "postgres".
# ⚠️ Deployments MUST use "postgres" — free hosting disks are ephemeral, so the
# local file is wiped on restart and every account disappears.
USER_STORE=local

DATABASE_URL=postgresql://medicite:medicite@localhost:5433/medicite

# Raw file storage: "local" or "s3"
STORAGE_BACKEND=local
S3_BUCKET=

# Retrieval tuning
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANK_ENABLED=true

# Model per provider
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash
