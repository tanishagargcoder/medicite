# Required — answer generation
ANTHROPIC_API_KEY=sk-ant-...

# Vector store: "local" (numpy, zero setup) or "pgvector"
VECTOR_STORE=local
DATABASE_URL=postgresql://medicite:medicite@localhost:5433/medicite

# Raw file storage: "local" or "s3"
STORAGE_BACKEND=local
S3_BUCKET=

# Retrieval tuning
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANK_ENABLED=true

# Generation
ANTHROPIC_MODEL=claude-opus-4-8
